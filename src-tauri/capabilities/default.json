{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Nutrients Tauri app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "cors-fetch:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://10.27.13.32:3000/**" },
        { "url": "http://10.27.13.32:9000/**" },
        { "url": "https://huggingface.co/**" },
        { "url": "https://*.huggingface.co/**" },
        { "url": "https://*.hf.co/**" }
      ],
      "deny": []
    },
    "http:allow-fetch",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send"
  ]
}